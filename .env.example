# Salin menjadi .env lalu sesuaikan.
# Lokal (Docker):
DATABASE_URL="postgresql://lolos:lolos@localhost:5432/loloskerja?schema=public"
DIRECT_URL="postgresql://lolos:lolos@localhost:5432/loloskerja?schema=public"
# Di Neon: DATABASE_URL = connection string Pooled, DIRECT_URL = Direct (tanpa -pooler)

# Kunci penanda sesi login (WAJIB, minimal 16 karakter acak).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="ganti-dengan-teks-acak-panjang"

# Email yang saat mendaftar otomatis menjadi ADMIN. Daftar sendiri segera setelah deploy.
ADMIN_EMAIL="email-anda@contoh.com"
