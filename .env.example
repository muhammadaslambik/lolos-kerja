# Salin menjadi .env lalu sesuaikan.
# Lokal (Docker):
DATABASE_URL="postgresql://lolos:lolos@localhost:5432/loloskerja?schema=public"
DIRECT_URL="postgresql://lolos:lolos@localhost:5432/loloskerja?schema=public"
# Di Neon: DATABASE_URL = connection string "Pooled", DIRECT_URL = "Direct" (tanpa -pooler)

# Kata sandi untuk halaman /dashboard/admin dan /dashboard/employer (WAJIB di produksi)
ADMIN_USER="admin"
ADMIN_PASSWORD="ganti-dengan-kata-sandi-panjang"
